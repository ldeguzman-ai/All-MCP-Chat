# Public browser setting: the chat API used by the UI.
# In production this is /api/chat on the same host.
# Do not place LLM or MCP credentials in VITE_* variables.
VITE_CHAT_ENDPOINT=/api/chat

# Optional local override for the public app URL used in OAuth redirects.
# APP_BASE_URL=https://all-mcp-chat.internal.zenai-apps.com

# Postgres is required in production for encrypted per-user MCP OAuth tokens.
# DATABASE_URL=postgres://...

# Vertex uses workload identity. Do not put GOOGLE_CLOUD_PROJECT in App Foundry secrets.
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.0-flash
