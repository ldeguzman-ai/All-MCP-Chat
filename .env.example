# Public browser setting: the App Foundry server endpoint that handles chat.
# Do not place LLM or MCP credentials in VITE_* variables.
VITE_CHAT_ENDPOINT=https://your-app-foundry-host.example.com/api/chat

# Server-only App Foundry secret references. Configure their values in App Foundry.
APP_FOUNDRY_LLM_SECRET=your-managed-llm-secret-reference
MCP_GATEWAY_AUTH_SECRET=your-mcp-gateway-secret-reference
